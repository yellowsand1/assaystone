{
  "capability": "assaystone-repository",
  "owner": "yellowsand1",
  "systems": [
    "git",
    "github-actions",
    "pypi"
  ],
  "data_classes": [
    "public"
  ],
  "irreversible_actions": [
    "release"
  ],
  "risk": "high",
  "lifecycle": "shadow",
  "retention": "30d",
  "criteria": [
    {
      "id": "tests",
      "kind": "postcondition",
      "statement": "The test suite passes.",
      "oracle": "tests",
      "severity": "critical"
    },
    {
      "id": "lint",
      "kind": "postcondition",
      "statement": "Ruff passes on the package and tests.",
      "oracle": "lint",
      "severity": "critical"
    },
    {
      "id": "benchmark-current",
      "kind": "invariant",
      "statement": "The committed Failure Zoo report is current.",
      "oracle": "benchmark",
      "severity": "high"
    },
    {
      "id": "revertible",
      "kind": "invariant",
      "statement": "The release commit can be reversed.",
      "oracle": "rollback",
      "severity": "critical"
    },
    {
      "id": "build-reversible",
      "kind": "invariant",
      "statement": "A drill proved the release build can be undone.",
      "oracle": "reversibility",
      "severity": "critical"
    }
  ],
  "oracles": [
    {
      "id": "tests",
      "type": "command",
      "description": "unittest suite",
      "payload": {
        "command": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-t",
          "."
        ],
        "timeout": 600
      }
    },
    {
      "id": "lint",
      "type": "command",
      "description": "ruff",
      "payload": {
        "command": [
          "python3",
          "-m",
          "ruff",
          "check",
          "assaystone",
          "tests"
        ],
        "timeout": 120
      }
    },
    {
      "id": "benchmark",
      "type": "command",
      "description": "Failure Zoo report is not stale",
      "payload": {
        "command": [
          "sh",
          "-c",
          "python3 -m assaystone benchmark failure-zoo --md /tmp/assaystone-failure-zoo.md >/dev/null && diff -u docs/failure-zoo.md /tmp/assaystone-failure-zoo.md"
        ],
        "timeout": 300
      }
    },
    {
      "id": "rollback",
      "type": "command",
      "description": "the release commit reverse-applies",
      "payload": {
        "command": [
          "sh",
          "-c",
          "git diff HEAD~1 HEAD | git apply --check -R"
        ],
        "timeout": 60
      }
    },
    {
      "id": "build_pkg",
      "type": "command",
      "description": "build the distribution",
      "payload": {
        "command": [
          "python3",
          "-m",
          "build",
          "--outdir",
          "dist"
        ],
        "mutates": true,
        "timeout": 300
      }
    },
    {
      "id": "clean_dist",
      "type": "command",
      "description": "remove the built distribution",
      "payload": {
        "command": [
          "rm",
          "-rf",
          "dist"
        ],
        "mutates": true
      }
    },
    {
      "id": "reversibility",
      "type": "drill",
      "description": "a drill proved the build can be undone",
      "payload": {
        "manifest": ".assaystone/capability.json",
        "id": "build-dist"
      }
    }
  ],
  "policies": {
    "shadow": {
      "require": [
        "tests",
        "lint",
        "benchmark"
      ],
      "allow_merge": false
    },
    "production": {
      "require": [
        "tests",
        "lint",
        "benchmark",
        "reversibility"
      ],
      "allow_merge": true,
      "allow_deploy": true,
      "rollback_required": true,
      "rollback": "rollback"
    }
  },
  "manifest_approval": true,
  "reversibility": [
    {
      "id": "build-dist",
      "action": "build_pkg",
      "compensation": "clean_dist",
      "state": [
        "dist"
      ],
      "note": "the release build leaves only dist/, which is removable"
    }
  ]
}
