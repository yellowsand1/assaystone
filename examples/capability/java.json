{
  "capability": "java-change",
  "owner": "platform-team",
  "systems": ["git", "maven", "mysql", "ci"],
  "data_classes": ["internal"],
  "irreversible_actions": ["merge", "deploy", "ddl"],
  "risk": "high",
  "lifecycle": "shadow",
  "retention": "90d",
  "criteria": [
    {"id": "compiles", "kind": "postcondition", "statement": "The Java project compiles.", "oracle": "compile", "severity": "critical"},
    {"id": "tests-pass", "kind": "postcondition", "statement": "The test suite passes.", "oracle": "tests", "severity": "critical"},
    {"id": "migration-reversible", "kind": "invariant", "statement": "The migration has a rollback path.", "oracle": "migration", "severity": "critical"},
    {"id": "dba-approved", "kind": "evidence", "statement": "A DBA approved the migration.", "oracle": "dba", "severity": "critical"},
    {"id": "feature-branch", "kind": "precondition", "statement": "The change is on a feature branch.", "oracle": "branch", "severity": "high"}
  ],
  "oracles": [
    {"id": "compile", "type": "command", "description": "Maven compile", "payload": {"command": ["mvn", "-q", "-DskipTests", "compile"], "timeout": 600}},
    {"id": "tests", "type": "command", "description": "Maven test", "payload": {"command": ["mvn", "-q", "test"], "timeout": 900}},
    {"id": "migration", "type": "command", "description": "Flyway validate", "payload": {"command": ["mvn", "-q", "flyway:validate"], "timeout": 300}},
    {"id": "classes", "type": "file", "description": "compile output exists", "payload": {"path": "target/classes", "mode": "exists"}},
    {"id": "dba", "type": "human", "description": "DBA approval", "payload": {"action": "ddl", "record": "approvals.json"}},
    {"id": "branch", "type": "git", "description": "feature branch", "payload": {"mode": "branch", "expected": "feature/"}}
  ],
  "policies": {
    "shadow": {"require": ["compile", "tests", "classes", "branch"], "allow_merge": false},
    "canary": {"require": ["compile", "tests", "classes", "migration", "branch"], "approvals": ["dba"], "allow_merge": true},
    "production": {"require": ["compile", "tests", "classes", "migration", "branch"], "approvals": ["dba"], "allow_merge": true, "allow_deploy": true, "rollback_required": true}
  }
}
