        {
          "name": "evidence.claims"
        },
        {
          "name": "tests.pass"
        }
      ],
      "domain": "code"
    },
    {
      "name": "ops_lineage",
      "kind": "traces",
      "category": "adversarial",
      "domain": "ops",
      "source": "traces/ops",
      "baseline": "../ops_agent/baseline",
      "test_command": [
        "{python}",
        "-c",
        "pass"
      ],
      "required_defects": [
        "over-limit",
        "double-refund",
        "missing-approval",
        "missing-approval-lineage",
        "status-inconsistent",
        "wrong-approval"
      ],
      "verifiers": [
        {
          "name": "ops.json_valid"
        },
        {
          "name": "ops.amount_conserved"
        },
        {
          "name": "ops.no_double_refund"
        },
        {
          "name": "ops.refund_limit",
          "params": {
            "limit_cents": 10000
          }
        },
        {
          "name": "ops.status_consistent"
        },
        {
          "name": "ops.approval_recorded",
          "params": {
            "require_approval_for": [
              "refund.create"
            ]
          }
        },
        {
          "name": "ops.approval_lineage",
          "params": {
            "require_approval_for": [
              "refund.create"
            ]
          }
        },
        {
          "name": "ops.refund_lineage"
        }
