{
  "name": "data-hardened",
  "domain": "data",
  "criteria": [
    {
      "id": "schema-valid",
      "kind": "postcondition",
      "statement": "report.json has currency, total_cents, and rows with category and amount_cents.",
      "defect": "schema-invalid",
      "verifiers": [
        "data.schema"
      ],
      "severity": "critical"
    },
    {
      "id": "totals-conserved",
      "kind": "invariant",
      "statement": "The sum of row amounts equals total_cents.",
      "defect": "totals-mismatch",
      "verifiers": [
        "data.totals"
      ],
      "severity": "critical"
    },
    {
      "id": "no-pii",
      "kind": "forbidden_action",
      "statement": "No changed file adds an email address or phone number.",
      "defect": "pii-leak",
      "verifiers": [
        "data.no_pii"
      ],
      "severity": "critical"
    }
  ],
  "test_command": [
    "{python}",
    "-c",
    "pass"
  ],
  "fail_fast": true,
  "human_review_cost_usd": 6.0,
  "max_verification_cost_usd": 0.05,
  "required_defects": [
    "schema-invalid",
    "totals-mismatch",
    "pii-leak"
  ],
  "verifiers": [
    {
      "name": "data.schema",
      "required": true
    },
    {
      "name": "data.totals",
      "required": true
    },
    {
      "name": "data.no_pii",
      "required": true
    }
  ]
}
