{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assaystone.dev/schema/contract.schema.json",
  "title": "Assaystone Contract",
  "description": "An acceptance contract: an ordered set of verifiers plus budgets and escalation policy.",
  "type": "object",
  "required": ["verifiers"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string"},
    "test_command": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fail_fast": {"type": "boolean"},
    "human_review_cost_usd": {"type": "number", "minimum": 0},
    "max_verification_cost_usd": {"type": "number", "minimum": 0},
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verifier"}
    }
  },
  "$defs": {
    "verifier": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "params": {"type": "object"}
      }
    }
  }
}